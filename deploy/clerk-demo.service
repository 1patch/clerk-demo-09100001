# Managed by clerk-demo deployment v1
[Unit]
Description=Clerk demo system under test
After=network.target

[Service]
Type=simple
User=clerk-demo
Group=clerk-demo
WorkingDirectory=/opt/clerk-demo
ExecStart=/usr/bin/node /opt/clerk-demo/sut/server.mjs
Environment=NODE_ENV=production
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
